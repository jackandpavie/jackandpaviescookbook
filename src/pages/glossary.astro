---
import Layout from '../layouts/Layout.astro';
const terms={Simmer:'Keep liquid gently bubbling over a low heat. Small bubbles rise now and then; the surface should not churn.',Sauté:'Cook food in a small amount of oil or butter, stirring or turning it so it cooks evenly.',Boil:'Heat liquid until large bubbles rise steadily and break across the surface.',Fold:'Use a spatula to lift a mixture from underneath and turn it over gently, keeping as much air as possible.',Whisk:'Beat with a whisk to blend ingredients or add air. Use the speed and time in your recipe.',Reduce:'Let a liquid gently simmer so some water evaporates and the sauce becomes thicker. Stir and watch it.',Brown:'Cook until the surface turns golden or brown. Watch the heat: brown adds flavour; black usually means burnt.',Sear:'Cook over a high heat to brown the outside quickly. Searing does not tell you whether the centre is cooked.',Knead:'Press, fold and stretch dough repeatedly to bring it together or develop its structure.'};
---
<Layout title="Kitchen words"><section class="glossary wrap narrow"><div class="page-heading"><span class="eyebrow">A LITTLE HELP ALONG THE WAY</span><h1>Kitchen words.</h1><p>No guesswork. Just what the recipe means.</p></div>{Object.entries(terms).map(([term,meaning])=><section id={term.toLowerCase()}><h2>{term}</h2><p>{meaning}</p></section>)}</section></Layout>
