---
import Layout from '../../layouts/Layout.astro';import {recipes,json,url} from '../../lib/data';
export function getStaticPaths(){return recipes.map(recipe=>({params:{slug:recipe.slug},props:{recipe}}));}
const {recipe:r}=Astro.props;
---
<Layout title={`Cooking ${r.title}`} cooking={true}>
 <section class="kitchen" id="kitchen"><header class="kitchen-header"><a href={url(`recipes/${r.slug}/`)} class="back-link">← Leave cooking mode</a><span class="eyebrow">YOUR KITCHEN COMPANION</span><button type="button" id="wake-button" class="text-link" aria-pressed="false">Keep screen awake</button></header><div class="kitchen-title"><p>{r.title}{r.demo?' · Demo':''}</p><span id="kitchen-completion">0 of {r.steps.length} complete</span></div><progress id="cooking-progress" max={r.steps.length} value="0" aria-label="Completed cooking steps"></progress>
 <div class="kitchen-layout"><div class="kitchen-main"><span class="eyebrow" id="step-label">STEP 01 OF {String(r.steps.length).padStart(2,'0')}</span><h1 id="cooking-title">{r.steps[0]?.title||'Ready to cook?'}</h1><p id="cooking-text">{r.steps[0]?.description}</p><div id="cooking-meta"></div><div id="cooking-cues"></div><img id="cooking-image" class="step-image" alt="" hidden/><div id="step-timer-slot"></div><div class="kitchen-controls"><button type="button" class="button secondary" id="step-previous">← Previous</button><button type="button" class="button" id="step-complete">Mark complete ✓</button><button type="button" class="button secondary" id="step-next">Next →</button></div><p class="kitchen-help">Your place is saved on this device. You can leave and come back.</p><p class="small-note" id="wake-status" role="status"></p></div><aside class="kitchen-sidebar"><div class="step-ingredients"><span class="eyebrow">FOR THIS STEP</span><h2>Have these ready.</h2><ul id="cooking-ingredients"></ul></div><details class="step-overview"><summary>All the steps</summary><ol id="step-navigation"></ol></details>{r.timeline.length>0&&<details><summary>The cooking timeline</summary><ol class="kitchen-timeline">{r.timeline.map(t=><li><strong>{t.start}–{t.end} min</strong> {t.task}{t.parallel&&<small>↳ {t.parallel}</small>}</li>)}</ol></details>}<details><summary>Useful kitchen words</summary><dl><dt>Simmer</dt><dd>Gentle small bubbles, below a vigorous boil.</dd><dt>Sauté</dt><dd>Cook in a little fat, stirring or turning.</dd><dt>Knead</dt><dd>Press, fold and stretch dough.</dd></dl></details><button type="button" class="text-link" id="reset-progress">Start this recipe again</button></aside></div><div id="cooking-finished" class="finished-notice" hidden><span aria-hidden="true">✳</span><h2>You made it.</h2><p>Take a moment. Set the table. Enjoy what you’ve made.</p><a href={url('recipes/')} class="text-link">Back to the cookbook ↗</a></div></section>
 <script type="application/json" id="recipe-data" set:html={json({recipe:r,base:import.meta.env.BASE_URL})}/>
</Layout>
