---
import Layout from '../../layouts/Layout.astro';import Card from '../../components/Card.astro';import {recipes,settings,json,cuisines,recipeTypes} from '../../lib/data';
const options=(key)=>[...new Set(recipes.flatMap(r=>Array.isArray(r[key])?r[key]:[r[key]]).filter(Boolean))].sort();
---
<Layout title="The recipes" active="recipes">
 <section class="library wrap"><div class="page-heading"><span class="eyebrow">FIND YOUR NEXT FAVOURITE</span><h1>The recipes<span class="title-dot">.</span></h1><p id="library-description">Familiar comforts, quick suppers and things worth taking your time over.</p></div>
 <form id="recipe-filters" class="filters" role="search"><div class="search-row"><label class="search-field"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg><span class="sr-only">Search names, ingredients and tags</span><input name="query" id="search" placeholder="A dish, an ingredient, a little craving…" type="search"/></label><label class="sort-label">Sort by<select name="sort"><option value="featured">Featured first</option><option value="alpha">A–Z</option><option value="quickest">Quickest first</option><option value="recent">Recently added</option></select></label></div><div class="filter-row"><label>Type<select name="type"><option value="">All types</option>{recipeTypes.map(c=><option>{c}</option>)}</select></label><label>Ready in<select name="time"><option value="">Any time</option><option value="20">20 minutes</option><option value="30">30 minutes</option><option value="45">45 minutes</option><option value="60">1 hour</option></select></label><label>Difficulty<select name="difficulty"><option value="">Any level</option>{options('difficulty').map(c=><option>{c}</option>)}</select></label><label>Cuisine<select name="cuisine"><option value="">All cuisines</option>{cuisines.map(c=><option>{c}</option>)}</select></label></div><div class="filter-summary"><label class="saved-filter"><input type="checkbox" name="saved"/> My saved recipes</label><button type="reset" class="text-link">Reset filters</button><span id="result-count" role="status">{recipes.length} recipes</span></div></form>
 <div class="recipe-grid library-grid" id="library-grid">{recipes.map((r,i)=><Card recipe={r} number={String(i+1).padStart(2,'0')}/>)}</div><div id="empty-results" class="empty-state" hidden><h2>No recipes just yet.</h2><p>Try a different search or reset the filters.</p><button type="button" class="button" id="empty-reset">Show all recipes</button></div><p class="demo-caption">Demo content is labelled on each card. Saved recipes stay on this browser and device.</p></section>
 <script type="application/json" id="library-data" set:html={json({recipes,collections:settings.collections})}/>
</Layout>
