---
import Layout from '../../layouts/Layout.astro';import Art from '../../components/Art.astro';import CarbChoices from '../../components/CarbChoices.astro';import {recipePages,total,url,media,json} from '../../lib/data';import {formatQuantity} from '../../lib/core.mjs';
export function getStaticPaths(){return recipePages.flatMap(r=>[r.slug,...(r.aliases||[])].map(slug=>({params:{slug},props:{recipe:r}})));}
const {recipe:r}=Astro.props;
const servingRecipe=recipePages.find(recipe=>recipe.slug===r.servingRecipe);
const glossary=['Simmer','Sauté','Boil','Fold','Whisk','Reduce','Brown','Sear','Knead'];
---
<Layout title={r.title} description={r.description} active="recipes">
 <article class="recipe-detail wrap" data-recipe={r.slug}>
 <a href={url('recipes/')} class="back-link">← Back to the recipes</a>
 <header class="recipe-hero"><div class="recipe-heading"><span class="eyebrow">{r.category} · {r.cuisine}{r.demo?' · DEMONSTRATION':''}</span><h1>{r.title}</h1><p>{r.description}</p>{r.personalNote&&<blockquote class="personal-note">{r.personalNote}</blockquote>}<div class="recipe-stats"><div><strong>{r.prepMinutes||0}<small> min</small></strong><span>PREP</span></div><div><strong>{r.cookMinutes||0}<small> min</small></strong><span>COOK</span></div>{r.restMinutes>0&&<div><strong>{r.restMinutes}<small> min</small></strong><span>REST</span></div>}<div><strong>{total(r)}<small> min</small></strong><span>TOTAL</span></div></div><p class="recipe-difficulty">{r.difficulty} · Makes {r.servings} {r.yieldUnit||'portions'}</p><div class="recipe-actions"><a href={url(`cook/${r.slug}/`)} class="button">Start cooking <span aria-hidden="true">→</span></a><button type="button" class="button secondary" data-favourite={r.canonicalSlug||r.slug} aria-pressed="false">Save recipe</button><button type="button" class="icon-button" data-print aria-label="Print recipe">Print ↗</button></div></div><figure class:list={['recipe-photo',`art-${r.art||'pasta'}`]}>{r.image?<img src={media(r.image)} alt={r.imageAlt||r.title} width="900" height="1000" style={`object-position:${r.imagePosition||'50% 50%'};--photo-zoom:${r.imageZoom||1}`}/>:<Art type={r.art||'pasta'}/>}<figcaption>{r.image?<>{r.imageCaption}{r.imageCredit&&<><br/>Photo: {r.imageSource?<a href={r.imageSource} target="_blank" rel="noopener">{r.imageCredit}</a>:r.imageCredit}{r.imageLicense&&<> · {r.imageLicenseUrl?<a href={r.imageLicenseUrl} target="_blank" rel="noopener">{r.imageLicense}</a>:r.imageLicense}</>}</> }</>: 'Illustrated placeholder · add your own photograph'}</figcaption></figure></header>
 <CarbChoices recipe={r}/>
 {r.demo&&<div class="notice">This is a demonstration recipe, not one supplied by Pavie. Replace or remove it in the editor.</div>}
 <nav class="recipe-jump" aria-label="Recipe sections"><a href="#before">Before you begin</a><a href="#ingredients">Ingredients</a><a href="#method">The method</a>{r.timeline.length>0&&<a href="#timeline">Your timeline</a>}</nav>
 {r.story&&<section class="story-section"><span class="eyebrow">A LITTLE NOTE FROM ME</span><p>{r.story}</p></section>}
 <section id="before" class="before-section"><div><span class="eyebrow">A MOMENT TO GET READY</span><h2>Before you begin.</h2></div><div>{r.equipment.length>0&&<><h3>What you’ll need</h3><ul class="equipment-list">{r.equipment.map(e=><li>{e}</li>)}</ul></>}{r.advancePrep&&<p><strong>Prepare ahead:</strong> {r.advancePrep}</p>}{r.importantNotes&&<p class="important-note">{r.importantNotes}</p>}</div></section>
 <div class="recipe-body"><aside class="ingredients-panel" id="ingredients"><div class="section-heading compact"><h2>The ingredients.</h2><span class="eyebrow">READY, SET, PREP</span></div><div class="serving-control"><label for="servings">{r.portionLabel||'How many portions?'}</label><div><button type="button" id="servings-down" aria-label={`Fewer ${r.yieldUnit||'servings'}`}>−</button><input type="number" id="servings" min="1" max="24" value={r.defaultServings??r.servings} inputmode="numeric"/><button type="button" id="servings-up" aria-label={`More ${r.yieldUnit||'servings'}`}>+</button></div></div><p class="scaling-note">{r.portionNote&&<>{r.portionNote} </>}Quantities scale. Cooking times and the method stay as written. Check pan size for larger batches.</p><div id="ingredient-groups">{r.groups.map((g)=><section class="ingredient-group"><h3>{g.title}</h3><ul>{(g.ingredients||[]).map(i=><li><label><input type="checkbox" data-ingredient={i.id}/><span><strong><span data-quantity={i.id}>{formatQuantity(i.quantity)}</span> {i.unit}</strong> {i.name}{i.optional&&<small> (optional)</small>}{i.note&&<small class="ingredient-note">{i.note}</small>}</span></label></li>)}</ul></section>)}</div><button type="button" class="button secondary full" id="add-shopping">Add unchecked to shopping list ↗</button><button type="button" class="text-link" id="reset-ingredients">Untick ingredients</button><p class="small-note">Tick ingredients as you prepare them. Your checklist stays on this device.</p></aside>
 <section class="method" id="method"><span class="eyebrow">ONE THING AT A TIME</span><h2>Let’s make it.</h2><ol>{r.steps.map((s,i)=><li class="method-step"><span class="step-no">{String(i+1).padStart(2,'0')}</span><div><h3>{s.title}</h3><p>{s.description}</p><div class="step-meta">{s.heat&&<span>{s.heat}</span>}{s.durationMinutes>0&&<span>About {s.durationMinutes} min</span>}{s.timerMinutes>0&&<button type="button" class="timer-link" data-start-timer={s.id}>◷ Start {s.timerMinutes}-minute timer</button>}</div>{s.doneness&&<p class="step-cue"><strong>Look for:</strong> {s.doneness}</p>}{s.tip&&<p class="step-tip"><strong>A little help:</strong> {s.tip}</p>}{s.warning&&<p class="step-warning"><strong>Take care:</strong> {s.warning}</p>}{s.image&&<img class="step-image" src={media(s.image)} alt={s.imageAlt||s.title} width="600" height="400" loading="lazy"/>}</div></li>)}</ol><a href={url(`cook/${r.slug}/`)} class="button">Cook with me, step by step →</a></section></div>
 {r.timeline.length>0&&<section class="timeline-section" id="timeline"><div><span class="eyebrow">THE WHOLE PICTURE</span><h2>Your cooking timeline.</h2><p>Elapsed minutes from when you begin. These are a guide — use the visual cues and packet instructions too.</p><div class="timeline-key"><span>● Active</span><span>○ Simmer / bake</span><span>◌ Rest</span></div></div><ol class="timeline">{r.timeline.map(t=><li class={`timeline-${t.mode||'active'}`}><span class="timeline-time">{t.start}–{t.end}<small>MINUTES</small></span><div><h3>{t.task}</h3>{t.parallel&&<p>↳ {t.parallel}</p>}<span class="eyebrow">{t.mode==='passive'?'SIMMER / BAKE':t.mode==='rest'?'REST':'ACTIVE COOKING'}</span></div></li>)}</ol></section>}
 <section class="recipe-extras">{r.substitutions.length>0&&<div><h2>Make it work for you.</h2>{r.substitutions.map(n=><details><summary>{n.title}</summary><p>{n.text}</p></details>)}</div>}{r.troubleshooting.length>0&&<div><h2>A little reassurance.</h2>{r.troubleshooting.map(n=><details><summary>{n.title}</summary><p>{n.text}</p></details>)}</div>}{(r.storage||r.reheating||r.foodSafety)&&<div><h2>For another day.</h2>{r.storage&&<p><strong>Storage:</strong> {r.storage}</p>}{r.reheating&&<p><strong>Reheating:</strong> {r.reheating}</p>}{r.foodSafety&&<p><strong>Food safety:</strong> {r.foodSafety}</p>}</div>}{(r.servingSuggestion||servingRecipe)&&<div><h2>At the table.</h2>{r.servingSuggestion&&<p>{r.servingSuggestion}</p>}{servingRecipe&&<p><a class="text-link" href={url(`recipes/${servingRecipe.slug}/`)}>{servingRecipe.title} ↗</a></p>}</div>}{r.glossary.length>0&&<div><h2>Kitchen words.</h2><p>Need a little explanation?</p>{r.glossary.filter(g=>glossary.includes(g)).map(g=><a class="word-pill" href={url(`glossary/#${g.toLowerCase()}`)}>{g} ↗</a>)}</div>}</section>
 {r.gallery.length>0&&<section class="gallery">{r.gallery.map(i=><figure><img src={media(i.image||i)} alt={i.alt||r.title} width="700" height="500" loading="lazy"/>{i.caption&&<figcaption>{i.caption}</figcaption>}</figure>)}</section>}
 </article><script type="application/json" id="recipe-data" set:html={json({recipe:r,base:import.meta.env.BASE_URL})}/>
</Layout>
