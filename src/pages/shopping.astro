---
import Layout from '../layouts/Layout.astro';
---
<Layout title="The shopping list"><section class="shopping wrap narrow"><div class="page-heading"><span class="eyebrow">A LITTLE PREPARATION</span><h1>The shopping list.</h1><p>Ingredients from your recipes, gathered in one place.</p></div><p class="notice">This list stays on this browser and device. Matching ingredients with the same unit and preparation note are combined.</p><div id="shopping-items"></div><div id="shopping-empty" class="empty-state"><h2>Something good starts here.</h2><p>Open a recipe and add its unchecked ingredients to your list.</p></div><div class="shopping-actions"><button type="button" class="button" id="copy-shopping">Copy list</button><button type="button" class="button secondary" data-print>Print list</button><button type="button" class="text-link" id="clear-shopping">Clear the list</button></div></section></Layout>
