---
import '../styles/global.css';
import {settings,url,colours} from '../lib/data';
const {title=settings.title,description=settings.subtitle,active='',cooking=false}=Astro.props;
---
<!doctype html>
<html lang="en-GB" style={`--paper:${colours.background};--ink:${colours.ink};--olive:${colours.olive};--rust:${colours.accent}`}>
 <head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content={colours.background}/><title>{title===settings.title?title:`${title} · ${settings.title}`}</title><link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/></head>
 <body class:list={[{ 'in-kitchen':cooking}]}>
 <a href="#main" class="skip-link">Skip to content</a>
 {!cooking&&<header class="site-header"><a class="wordmark" href={url()}><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 6q6-2 11 2q5-4 11-2v20q-6-2-11 2q-5-4-11-2zM16 8v20"/><path d="M9 12h3m-3 4h3m8-4h3m-3 4h3"/></svg><span>{settings.title}<small>A PERSONAL COLLECTION</small></span></a><nav aria-label="Main navigation"><a href={url('recipes/')} aria-current={active==='recipes'?'page':undefined}>The recipes</a><a href={url('about/')} aria-current={active==='about'?'page':undefined}>A little note</a><a href={url('recipes/?saved=1')} class="nav-saved">Saved <span data-saved-count>0</span></a><a href={url('shopping/')} aria-label="Shopping list" class="nav-basket"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9h18l-2 11H5zM8 9l4-7 4 7M9 13v4m6-4v4"/></svg></a></nav></header>}
 <main id="main"><slot/></main>
 {!cooking&&<footer class="site-footer"><span class="footer-mark">{settings.title}</span><p>{settings.footerMessage}</p><div><a href={url('glossary/')}>Kitchen words</a><a href={url('edit/')}>For the recipe keeper</a><a href={url('birthday/')}>The birthday card</a></div><small>Favourites, checklists and cooking progress stay on this device.</small></footer>}
 <aside id="timer-tray" class="timer-tray" aria-label="Kitchen timers" hidden><div class="timer-tray-head"><strong>Your timers</strong><button type="button" id="timer-collapse" aria-expanded="true">Hide timers</button></div><div id="timer-items"></div><small>Keep this page open for sound. Background alerts may be delayed.</small></aside>
 <div class="toast" role="status" id="toast" hidden></div>
 <noscript><p class="notice">Recipes are readable without JavaScript. Turn it on for timers, checklists, search and cooking mode.</p></noscript>
 <script>import {initApp} from '../scripts/app.mjs';initApp();</script>
 </body>
</html>
